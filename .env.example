# Public client configuration from Supabase Project Settings > API.
# Copy this file to .env and replace the placeholders.
# Never commit a Supabase secret/service-role key to the mobile app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
